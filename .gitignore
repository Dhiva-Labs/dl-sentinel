# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
coverage/
# The action bundle is generated (npm run bundle:action) and committed only on
# release tags, never on main — see docs/releasing.md.
apps/action/bundle/

# Runtime data (API server storage, local scan output)
.dl-sentinel/
*.log

# Local environment / secrets — never commit
.env
.env.*

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Local agent/tooling state — never commit
.claude/
CLAUDE.md

# Generated CLI bundle for Debian packaging (npm run bundle:cli).
packaging/cli-bundle/

# debhelper build output. Only the hand-written packaging inputs are tracked.
debian/.debhelper/
debian/dlsentinel/
debian/files
debian/*.substvars
debian/debhelper-build-stamp
