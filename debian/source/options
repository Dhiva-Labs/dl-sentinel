# The working tree carries the full monorepo (node_modules, per-package dist/
# output, test scratch). None of it belongs in the source package: the only
# build input the package needs is packaging/cli-bundle/, which is generated by
# `npm run bundle:cli` before the package is built.
tar-ignore = "node_modules"
tar-ignore = ".git"
tar-ignore = "dist"
tar-ignore = "bundle"
tar-ignore = "*.tsbuildinfo"
tar-ignore = ".dl-sentinel"
tar-ignore = "coverage"
tar-ignore = "*.deb"
tar-ignore = "*.buildinfo"
tar-ignore = "*.changes"
