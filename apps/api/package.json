{
  "name": "@dl-sentinel/api-server",
  "version": "0.1.0",
  "description": "DL Sentinel HTTP API server (self-hosted)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sentinel-api": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@dl-sentinel/core": "*",
    "@dl-sentinel/engine": "*",
    "@dl-sentinel/preset": "*",
    "@dl-sentinel/reporting": "*",
    "@dl-sentinel/web": "*"
  }
}
